const KEY='flowcore_demo_v1';
const initial={sales:[],expenses:[],inventory:[{id:1,name:'Sample product',sku:'SKU-001',qty:12,price:45}],customers:[]};
let db=JSON.parse(localStorage.getItem(KEY)||'null')||initial;unction save(){localStorage.setItem(KEY,JSON.stringify(db));}
let page='dashboard';const content=document.querySelector('#content');
const money=n=>new Intl.NumberFormat('en-GH',{style:'currency',currency:'GHS',maximumFractionDigits:2}).format(Number(n)||0);
const dateFmt=d=>new Date(d+'T00:00:00').toLocaleDateString('en-GH',{day:'numeric',month:'short',year:'numeric'});
const today=()=>new Date().toISOString().slice(0,10);
function sum(list,key){return list.reduce((a,x)=>a+(Number(x[key])||0),0)}
function heading(title,desc,button=''){return `<div class="page-heading"><div><h1>${title}</h1><p>${desc}</p></div>${button}</div>`}
function stat(label,value,foot,icon){return `<div class="stat-card"><span class="stat-icon">${icon}</span><div class="stat-label">${label}</div><div class="stat-value">${value}</div><div class="stat-foot">${foot}</div></div>`}
function table(headers,rows){return `<div class="table-wrap"><table class="table"><thead><tr>${headers.map(h=>`<th>${h}</th>`).join('')}</tr></thead><tbody>${rows.length?rows.join(''):`<tr><td colspan="${headers.length}"><div class="empty">Nothing here yet. Add your first record.</div></td></tr>`}</tbody></table></div>`}
function show(){document.querySelector('#crumb').textContent=page[0].toUpperCase()+page.slice(1);document.querySelectorAll('.nav-item').forEach(b=>b.classList.toggle('active',b.dataset.page===page));if(page==='dashboard')dashboard();else if(page==='sales')salesPage();else if(page==='expenses')expensesPage();else if(page==='inventory')inventoryPage();else if(page==='customers')customersPage();else reportsPage();}
function dashboard(){let revenue=sum(db.sales,'amount'),expenses=sum(db.expenses,'amount'),units=db.inventory.reduce((a,p)=>a+(+p.qty||0),0);let latest=[...db.sales.map(s=>({type:'Sale',desc:s.customer||'Customer',amount:s.amount,date:s.date,icon:'↗'})),...db.expenses.map(e=>({type:'Expense',desc:e.category,date:e.date,amount:-e.amount,icon:'↘'}))].sort((a,b)=>b.date.localeCompare(a.date)).slice(0,5);let bars=[30,45,34,60,52,74,48,62,82,55,68,90];content.innerHTML=heading('Dashboard','Your business overview at a glance.')+`<div class="cards">${stat('Total revenue',money(revenue),`${db.sales.length} recorded sales`,'↗')}${stat('Total expenses',money(expenses),`${db.expenses.length} recorded expenses`,'↘')}${stat('Net balance',money(revenue-expenses),'Revenue minus expenses','◈')}${stat('Inventory units',units,`${db.inventory.length} products tracked`,'▤')}</div><div class="grid-two"><div class="panel"><div class="panel-head"><h2>Business activity</h2><small>Demo visualization</small></div><div class="chart">${bars.map((h,i)=>`<div class="bar-group"><div class="bar" style="height:${h}%"></div><div class="bar second" style="height:${Math.max(12,h*.55)}%"></div><span class="bar-label">${['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][i]}</span></div>`).join('')}</div><div class="chart-legend"><span><i></i>Sales</span><span><i class="light"></i>Expenses</span></div></div><div class="panel"><div class="panel-head"><h2>Recent activity</h2><small>Latest records</small></div><div class="activity">${latest.length?latest.map(x=>`<div class="activity-row"><div class="activity-icon">${x.icon}</div><div><strong>${x.type} · ${x.desc}</strong><small>${dateFmt(x.date)}</small></div><span class="activity-amount" style="color:${x.amount<0?'var(--red)':'var(--green)'}">${x.amount<0?'−':'+'}${money(Math.abs(x.amount))}</span></div>`).join(''):`<div class="empty">Your recent activity will appear here.</div>`}</div></div></div>`}
function salesPage(){content.innerHTML=heading('Sales','Record and track revenue.',`<button class="btn primary" onclick="openForm('sale')">＋ Record sale</button>`)+`<div class="cards">${stat('Sales total',money(sum(db.sales,'amount')),`${db.sales.length} transactions`,'↗')}${stat('Average sale',money(db.sales.length?sum(db.sales,'amount')/db.sales.length:0),'Average per transaction','◈')}</div>`+table(['Date','Customer','Description','Amount'],db.sales.slice().sort((a,b)=>b.date.localeCompare(a.date)).map(s=>`<tr><td>${dateFmt(s.date)}</td><td>${s.customer||'Walk-in'}</td><td>${s.description||'Sale'}</td><td><strong>${money(s.amount)}</strong></td></tr>`))}
function expensesPage(){content.innerHTML=heading('Expenses','Understand where your money goes.',`<button class="btn primary" onclick="openForm('expense')">＋ Add expense</button>`)+`<div class="cards">${stat('Expenses total',money(sum(db.expenses,'amount')),`${db.expenses.length} entries`,'↘')}${stat('Expense categories',new Set(db.expenses.map(e=>e.category)).size,'Categories used','▦')}</div>`+table(['Date','Category','Description','Amount'],db.expenses.slice().sort((a,b)=>b.date.localeCompare(a.date)).map(e=>`<tr><td>${dateFmt(e.date)}</td><td>${e.category}</td><td>${e.description||'—'}</td><td><strong style="color:var(--red)">${money(e.amount)}</strong></td></tr>`))}
function inventoryPage(){content.innerHTML=heading('Inventory','Keep track of products and stock.',`<button class="btn primary" onclick="openForm('product')">＋ Add product</button>`)+`<div class="cards">${stat('Products',db.inventory.length,'Items in catalogue','▤')}${stat('Units in stock',db.inventory.reduce((a,p)=>a+(+p.qty||0),0),'Across all products','▦')}${stat('Stock value',money(db.inventory.reduce((a,p)=>a+p.qty*p.price,0)),'Based on selling price','◈')}</div>`+table(['Product','SKU','Quantity','Unit price','Status'],db.inventory.map(p=>`<tr><td><strong>${p.name}</strong></td><td>${p.sku||'—'}</td><td>${p.qty}</td><td>${money(p.price)}</td><td><span class="tag" style="${p.qty<5?'background:#fff1ed;color:#d25a43':''}">${p.qty<5?'Low stock':'In stock'}</span></td></tr>`))}
function customersPage(){content.innerHTML=heading('Customers','Manage your customer relationships.',`<button class="btn primary" onclick="openForm('customer')">＋ Add customer</button>`)+`<div class="cards">${stat('Customers',db.customers.length,'Saved customer records','♙')}</div>`+table(['Name','Phone','Email','Added'],db.customers.map(c=>`<tr><td><strong>${c.name}</strong></td><td>${c.phone||'—'}</td><td>${c.email||'—'}</td><td>${dateFmt(c.date)}</td></tr>`))}
function reportsPage(){let rev=sum(db.sales,'amount'),exp=sum(db.expenses,'amount');let cats={};db.expenses.forEach(e=>cats[e.category]=(cats[e.category]||0)+Number(e.amount));content.innerHTML=heading('Reports','A simple snapshot of your financial performance.')+`<div class="cards">${stat('Revenue',money(rev),'All recorded sales','↗')}${stat('Expenses',money(exp),'All recorded expenses','↘')}${stat('Net result',money(rev-exp),'Revenue less expenses','◈')}${stat('Net margin',rev?((rev-exp)/rev*100).toFixed(1)+'%':'—','Net result ÷ revenue','％')}</div><div class="panel"><div class="panel-head"><h2>Expense breakdown</h2></div>${Object.keys(cats).length?table(['Category','Total'],Object.entries(cats).sort((a,b)=>b[1]-a[1]).map(([k,v])=>`<tr><td>${k}</td><td>${money(v)}</td></tr>`)):`<div class="empty">Record expenses to see category breakdown.</div>`}</div><div class="report-note"><strong>Note:</strong> These are basic management figures based only on records entered in this demo. They are not audited accounts or tax reports.</div>`}
function openForm(type){let config={sale:{title:'Record sale',fields:[['date','Date','date',today()],['customer','Customer name','text',''],['description','Description','text',''],['amount','Amount (GHS)','number','']]},expense:{title:'Add expense',fields:[['date','Date','date',today()],['category','Category','text','General'],['description','Description','text',''],['amount','Amount (GHS)','number','']]},product:{title:'Add product',fields:[['name','Product name','text',''],['sku','SKU / code','text',''],['qty','Quantity','number','0'],['price','Unit price (GHS)','number','0']]},customer:{title:'Add customer',fields:[['name','Customer name','text',''],['phone','Phone','tel',''],['email','Email','email','']]}}[type];document.querySelector('#modal-title').textContent=config.title;document.querySelector('#modal-fields').innerHTML=config.fields.map(([id,label,t,val])=>`<label class="field"><span>${label}</span><input name="${id}" type="${t}" value="${val}" ${['name','amount'].includes(id)?'required':''} ${t==='number'?'step="0.01" min="0"':''}></label>`).join('');let dlg=document.querySelector('#modal');dlg.showModal();document.querySelector('#modal-save').onclick=(ev)=>{ev.preventDefault();let form=document.querySelector('#modal-form');if(!form.reportValidity())return;let data=Object.fromEntries(new FormData(form).entries());if(type==='sale'||type==='expense')data.amount=Number(data.amount);if(type==='product'){data.qty=Number(data.qty);data.price=Number(data.price)}data.id=Date.now();if(type==='customer')data.date=today();db[{sale:'sales',expense:'expenses',product:'inventory',customer:'customers'}[type]].push(data);save();dlg.close();show()}}
document.querySelector('#nav').addEventListener('click',e=>{let b=e.target.closest('[data-page]');if(b){page=b.dataset.page;show()}});show();
